{
  "name": "lithos-ui",
  "description": "A free, neo-brutalist React component library built with absolute structural integrity.",
  "license": "MIT",
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwind",
    "neobrutalism",
    "lithos"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lithosui/Lithos_UI.git"
  },
  "bugs": {
    "url": "https://github.com/lithosui/Lithos_UI/issues"
  },
  "homepage": "https://github.com/lithosui/Lithos_UI#readme",
  "private": false,
  "version": "0.1.4",
  "author": "David Akinloye",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "bin": {
    "lithos-ui": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "node init && vite",
    "build": "node init && vite build",
    "build:cli": "node init && tsc -p tsconfig.cli.json",
    "build:registry": "node init && pnpm build:cli && node dist/cli/build-registry.js",
    "build:lib": "node init && vite build -c vite.lib.config.ts && npx @tailwindcss/cli -i ./src/tokens.css -o ./dist/tokens.css",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "clsx": "^2.1.1",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prefer-arrow-functions": "^3.10.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "3.9.4",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.1",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "packageManager": "pnpm@9.10.0+sha512.73a29afa36a0d092ece5271de5177ecbf8318d454ecd701343131b8ebc0c1a91c487da46ab77c8e596d6acf1461e3594ced4becedf8921b074fbd8653ed7051c",
  "pnpm": {
    "overrides": {
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "@babel/core@<=7.29.0": ">=7.29.6",
      "brace-expansion@>=3.0.0 <5.0.7": ">=5.0.7",
      "react-router@>=7.12.0 <8.3.0": ">=8.3.0",
      "brace-expansion@<=5.0.7": ">=5.0.8",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "nanoid@<3.3.17": ">=3.3.17",
      "browserslist": ">=4.28.7",
      "baseline-browser-mapping": ">=2.11.0",
      "undici@>=8.1.0 <8.10.2": ">=8.10.2",
      "undici@>=8.0.0 <8.10.2": ">=8.10.2",
      "undici@>=8.10.0 <8.10.2": ">=8.10.2",
      "brace-expansion@>=4.0.0 <5.0.12": ">=5.0.12",
      "brace-expansion@>=4.0.0 <5.0.11": ">=5.0.11",
      "brace-expansion@>=4.0.0 <5.0.10": ">=5.0.10",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2",
      "vite@>=8.0.0 <=8.1.5": ">=8.1.6"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  }
}
